# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ========================
# Frontend (Next.js)
# ========================

# dependencies
frontend/node_modules
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# testing
frontend/coverage

# next.js
frontend/.next/
frontend/out/

# production
frontend/build

# typescript
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# vercel
.vercel

# ========================
# Backend (FastAPI/Python)
# ========================
backend/__pycache__/
backend/*.py[cod]
backend/.venv/
backend/*.egg-info/

# ========================
# Data (never commit large files)
# ========================
Data/
*.nc
*.h5
*.hdf5
.venv/

# ========================
# Misc
# ========================
.DS_Store
*.pem
.env*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*