# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ========================
# Frontend (Next.js)
# ========================

# dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage

# next.js
**/.next/
**/out/

# production
**/build

# typescript

**/*.tsbuildinfo
**/next-env.d.ts

# vercel
**/.vercel

# ========================
# Backend (FastAPI/Python)
# ========================
backend/__pycache__/
backend/*.py[cod]
backend/.venv/
backend/*.egg-info/

# ========================
# Data (never commit large files)
# ========================
Data/
*.nc
*.h5
*.hdf5
.venv/

# ========================
# Misc
# ========================
.DS_Store
*.pem
.env*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*